# ツイ廃マーケター 環境変数サンプル
# 使う時は `cp .env.example .env` して値を入れ、`export $(grep -v '^#' .env | xargs)` などで読み込む。
# .env は絶対に git にコミットしないこと（.gitignore 済み）。

# === Grok 抽出版：必要な鍵はこれ1つだけ ===
# 価値抽出・ツイート抽出(Live Search)・タイムライン予測・アクション設計すべてに使用。
# config の llm.provider = "grok" / collection.provider = "grok"
XAI_API_KEY=

# --- 任意 ---
# Claude を LLM に使いたい場合（config の llm.provider = "anthropic"）※収集はGrok必須
# ANTHROPIC_API_KEY=

# X API 収集に切り替える場合のみ（collection.provider = "xapi" または --provider xapi）
# X_BEARER_TOKEN=
