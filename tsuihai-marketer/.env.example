# ツイ廃マーケター 環境変数サンプル
# 使う時は `cp .env.example .env` して値を入れ、`export $(grep -v '^#' .env | xargs)` などで読み込む。
# .env は絶対に git にコミットしないこと（.gitignore 済み）。

# --- LLM（価値抽出・タイムライン予測・アクション設計に使用）---
# Grok(xAI) を使う場合（config の llm.provider = "grok"）
XAI_API_KEY=

# Claude を使う場合（config の llm.provider = "anthropic"）
ANTHROPIC_API_KEY=

# --- X API（ツイート収集は nob さんの x-audience-research-kit 側で使用）---
# こちらは kit の .env に設定する。X Premium / X API の課金が必要。
X_BEARER_TOKEN=
